# Copy to .env.local for local magic-link login.
# Leave these unset to run the app local-only (login stays hidden).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. GitHub Pages builds already pass --base=/raise-the-bar-rating/
# VITE_BASE=/raise-the-bar-rating/
