# Copy to .env.local for local magic-link login.
# Leave these unset to run the app local-only (login stays hidden).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only (Vercel functions). Never prefix these with VITE_.
# Service account JSON (or base64 of that JSON) so /api can read webhook secrets.
# FIREBASE_SERVICE_ACCOUNT=
# Optional alias; defaults to VITE_FIREBASE_PROJECT_ID.
# FIREBASE_PROJECT_ID=
